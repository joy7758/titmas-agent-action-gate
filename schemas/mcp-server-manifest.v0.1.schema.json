{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joy7758/titmas-agent-action-gate/schemas/mcp-server-manifest.v0.1.schema.json",
  "title": "TITMAS Action Gate MCP server manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_schema_version", "server", "status", "transport", "holds_provider_credentials", "tools"],
  "properties": {
    "$schema": {"type": "string"},
    "manifest_schema_version": {"const": "0.1.0"},
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "titmas-action-gate"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "status": {"const": "SPECIFICATION_ONLY"},
    "transport": {"enum": ["streamable-http", "stdio"]},
    "holds_provider_credentials": {"const": false},
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "input_schema", "output_schema", "mutates_external_provider", "authority_effect"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
          "description": {"type": "string", "minLength": 10},
          "input_schema": {"type": "string", "minLength": 1},
          "output_schema": {"type": "string", "minLength": 1},
          "mutates_external_provider": {"const": false},
          "authority_effect": {"enum": ["NONE", "EVIDENCE_RESULT_ONLY", "BOUNDED_DECISION_ONLY", "APPROVAL_INPUT_ONLY"]}
        }
      }
    }
  }
}
