{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joy7758/titmas-agent-action-gate/schemas/policy-evaluation-result.v0.1.schema.json",
  "title": "Policy evaluation result v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "ruleset_sha256",
    "request_id",
    "request_binding",
    "effect",
    "risk_class",
    "required_evidence_types",
    "evaluated_at"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "policy_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,63}$"},
    "policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "ruleset_sha256": {"$ref": "#/$defs/sha256"},
    "request_id": {"type": "string", "pattern": "^aar-[a-z0-9-]{8,64}$"},
    "request_binding": {"$ref": "#/$defs/requestBinding"},
    "effect": {"enum": ["DENY", "ALLOW_WITHOUT_APPROVAL", "REQUIRE_HUMAN_APPROVAL"]},
    "risk_class": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "required_evidence_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}
    },
    "evaluated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "requestBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "provider", "repository", "resource_ref", "parameters_sha256"],
      "properties": {
        "action": {"type": "string"},
        "provider": {"type": "string"},
        "repository": {"type": "string"},
        "resource_ref": {"type": "string"},
        "parameters_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
