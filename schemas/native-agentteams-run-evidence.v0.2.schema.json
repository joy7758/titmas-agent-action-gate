{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joy7758/titmas-agent-action-gate/schemas/native-agentteams-run-evidence.v0.2.schema.json",
  "title": "TITMAS M4 native AgentTeams autonomous run evidence v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "status", "started_at", "finished_at", "source", "runtime", "autonomy",
    "principals", "skills", "cloud_context", "isolation", "workflow_stages", "canonical_evidence", "deterministic_gate",
    "adversarial_cases", "provider_effects", "exit_criteria", "retained_failures", "non_claims", "runtime_disposition"
  ],
  "properties": {
    "schema_version": {"const": "0.2.0"},
    "run_id": {"type": "string", "pattern": "^run-[A-Za-z0-9][A-Za-z0-9._-]{7,127}$"},
    "status": {"enum": ["PASS", "FAIL", "NOT_ASSESSED"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "branch", "commit", "dirty", "titmas_core_protocols_changed"],
      "properties": {
        "repository": {"const": "https://github.com/joy7758/titmas-agent-action-gate"},
        "branch": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "dirty": {"type": "boolean"},
        "titmas_core_protocols_changed": {"type": "boolean"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentteams_release", "agentteams_commit", "manager_runtime", "leader_runtime", "model"],
      "properties": {
        "agentteams_release": {"const": "v1.2.0"},
        "agentteams_commit": {"const": "793db242257a569d911b1aa59c1cd554af78511f"},
        "manager_runtime": {"type": "string", "minLength": 1},
        "leader_runtime": {"type": "string", "minLength": 1},
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "preview", "live_probe"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "preview": {"type": "boolean"},
            "live_probe": {"enum": ["PASS", "FAIL", "NOT_ASSESSED"]}
          }
        }
      }
    },
    "autonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial_task_count", "intervention_count", "completed"],
      "properties": {
        "initial_task_count": {"type": "integer", "minimum": 0},
        "intervention_count": {"type": "integer", "minimum": 0},
        "completed": {"type": "boolean"}
      }
    },
    "principals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["principal_id", "principal_type", "credential_ref", "allowed_tools"],
        "properties": {
          "principal_id": {"type": "string", "minLength": 1},
          "principal_type": {"enum": ["worker", "human"]},
          "credential_ref": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "allowed_tools": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["worker_id", "name", "version", "package_sha256", "source_hash_verified", "runtime_loaded"],
        "properties": {
          "worker_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "package_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "source_hash_verified": {"type": "boolean"},
          "runtime_loaded": {"type": "boolean"}
        }
      }
    },
    "cloud_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "OFFICIAL_ALIBABA_CLOUD_SKILL_INSTALLED",
        "OFFICIAL_SKILL_ACTUALLY_INVOKED",
        "READ_ONLY_RAM_IDENTITY_USED",
        "SKILL_SOURCE_AND_HASH_RETAINED",
        "RUNTIME_LOADING_PROVEN",
        "INVOCATION_TRACE_RETAINED",
        "AGENT_EVIDENCE_RECEIPT_VALID",
        "CLOUD_RESOURCE_WRITE_EXECUTED",
        "DETERMINISTIC_GATE_AUTHORITY_PRESERVED",
        "SECRETS_COMMITTED"
      ],
      "properties": {
        "status": {"enum": ["CLOUD_CONTEXT_AVAILABLE", "NOT_ASSESSED", "NOT_ASSESSED_PERMISSION_DENIED", "BLOCKED_BY_SKILL_BOUNDARY", "SKILL_LOAD_REJECTED", "INVOCATION_FAILED"]},
        "OFFICIAL_ALIBABA_CLOUD_SKILL_INSTALLED": {"type": "boolean"},
        "OFFICIAL_SKILL_ACTUALLY_INVOKED": {"type": "boolean"},
        "READ_ONLY_RAM_IDENTITY_USED": {"type": "boolean"},
        "SKILL_SOURCE_AND_HASH_RETAINED": {"type": "boolean"},
        "RUNTIME_LOADING_PROVEN": {"type": "boolean"},
        "INVOCATION_TRACE_RETAINED": {"type": "boolean"},
        "AGENT_EVIDENCE_RECEIPT_VALID": {"type": "boolean"},
        "CLOUD_RESOURCE_WRITE_EXECUTED": {"const": false},
        "DETERMINISTIC_GATE_AUTHORITY_PRESERVED": {"type": "boolean"},
        "SECRETS_COMMITTED": {"const": false}
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "correlation_id", "task_id", "cross_run_blocked", "unexpected_request_count", "scoped_chain_issues"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "correlation_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "cross_run_blocked": {"type": "boolean"},
        "unexpected_request_count": {"type": "integer", "minimum": 0},
        "scoped_chain_issues": {"type": "array", "items": {"type": "string"}}
      }
    },
    "workflow_stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "stage", "worker_id", "task_id", "receipt_ref"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "stage": {"type": "string", "minLength": 1},
          "worker_id": {"type": "string", "minLength": 1},
          "task_id": {"type": "string", "minLength": 1},
          "receipt_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "canonical_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "canonical", "receipt_count", "chain_issues"],
      "properties": {
        "name": {"const": "agent-evidence"},
        "version": {"const": "0.6.0"},
        "canonical": {"type": "boolean"},
        "receipt_count": {"type": "integer", "minimum": 0},
        "chain_issues": {"type": "array", "items": {"type": "string"}}
      }
    },
    "deterministic_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sole_decision_authority", "engine_version", "decisions"],
      "properties": {
        "sole_decision_authority": {"type": "boolean"},
        "engine_version": {"const": "0.1.0"},
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["decision_id", "request_id", "outcome", "reason_codes"],
            "properties": {
              "decision_id": {"type": "string", "minLength": 1},
              "request_id": {"type": "string", "minLength": 1},
              "outcome": {"enum": ["ALLOW", "BLOCK", "REQUIRE_APPROVAL"]},
              "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "adversarial_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "passed", "reason_code", "provider_call_count", "business_state_delta", "security_audit_delta"],
        "properties": {
          "case_id": {"enum": ["A", "B", "C", "D", "E", "F", "G", "H"]},
          "passed": {"type": "boolean"},
          "reason_code": {"type": "string", "minLength": 1},
          "provider_call_count": {"type": "integer", "minimum": 0},
          "business_state_delta": {"type": "integer", "minimum": 0},
          "security_audit_delta": {"type": "integer", "minimum": 0}
        }
      }
    },
    "provider_effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_mode", "in_memory_action_count", "real_external_write", "merge", "release", "deploy", "tag", "publish", "competition_submit"],
      "properties": {
        "provider_mode": {"enum": ["IN_MEMORY_NO_EXTERNAL_WRITE", "NONE"]},
        "in_memory_action_count": {"type": "integer", "minimum": 0},
        "real_external_write": {"type": "boolean"},
        "merge": {"type": "boolean"},
        "release": {"type": "boolean"},
        "deploy": {"type": "boolean"},
        "tag": {"type": "boolean"},
        "publish": {"type": "boolean"},
        "competition_submit": {"type": "boolean"}
      }
    },
    "exit_criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "NATIVE_AGENTTEAMS_END_TO_END_AUTONOMOUS", "OPERATOR_INTERVENTION_COUNT_ZERO", "PER_WORKER_MCP_ACL_ENFORCED",
        "UNAUTHORIZED_TOOL_CALL_BLOCKED", "REPOSITORY_SKILLS_MATERIALIZED", "SKILL_HASH_ATTESTATION_VERIFIED",
        "CORRELATION_SCOPED_STATE_ISOLATION", "CROSS_RUN_CONTAMINATION_BLOCKED", "STABLE_NON_PREVIEW_MODEL_USED",
        "CANONICAL_AGENT_EVIDENCE_VERIFICATION", "DETERMINISTIC_GATE_AUTHORITY_PRESERVED", "NO_REAL_EXTERNAL_WRITE",
        "PRODUCTION_READY_FALSE", "TITMAS_CORE_PROTOCOLS_UNCHANGED", "M4_COMPLETE"
      ],
      "properties": {
        "NATIVE_AGENTTEAMS_END_TO_END_AUTONOMOUS": {"type": "boolean"},
        "OPERATOR_INTERVENTION_COUNT_ZERO": {"type": "boolean"},
        "PER_WORKER_MCP_ACL_ENFORCED": {"type": "boolean"},
        "UNAUTHORIZED_TOOL_CALL_BLOCKED": {"type": "boolean"},
        "REPOSITORY_SKILLS_MATERIALIZED": {"type": "boolean"},
        "SKILL_HASH_ATTESTATION_VERIFIED": {"type": "boolean"},
        "CORRELATION_SCOPED_STATE_ISOLATION": {"type": "boolean"},
        "CROSS_RUN_CONTAMINATION_BLOCKED": {"type": "boolean"},
        "STABLE_NON_PREVIEW_MODEL_USED": {"type": "boolean"},
        "CANONICAL_AGENT_EVIDENCE_VERIFICATION": {"type": "boolean"},
        "DETERMINISTIC_GATE_AUTHORITY_PRESERVED": {"type": "boolean"},
        "NO_REAL_EXTERNAL_WRITE": {"type": "boolean"},
        "PRODUCTION_READY_FALSE": {"type": "boolean"},
        "TITMAS_CORE_PROTOCOLS_UNCHANGED": {"type": "boolean"},
        "M4_COMPLETE": {"type": "boolean"}
      }
    },
    "retained_failures": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "non_claims": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "runtime_disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temporary_stack_destroyed", "transient_credentials_removed", "persistent_deployment", "production_deployment"],
      "properties": {
        "temporary_stack_destroyed": {"type": "boolean"},
        "transient_credentials_removed": {"type": "boolean"},
        "persistent_deployment": {"type": "boolean"},
        "production_deployment": {"type": "boolean"}
      }
    }
  }
}
