{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joy7758/titmas-agent-action-gate/schemas/mcp-tool-result.v0.1.schema.json",
  "title": "TITMAS Action Gate MCP tool result v0.1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "result"],
      "properties": {
        "ok": {"const": true},
        "result": {}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "error"],
      "properties": {
        "ok": {"const": false},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "details"],
          "properties": {
            "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
            "message": {"type": "string", "minLength": 1},
            "details": {"type": "object"}
          }
        }
      }
    }
  ]
}
