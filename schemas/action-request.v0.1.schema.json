{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joy7758/titmas-agent-action-gate/schemas/action-request.v0.1.schema.json",
  "title": "Action request v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "created_at",
    "requested_by",
    "action",
    "target",
    "parameters",
    "parameters_sha256",
    "evidence_requirements",
    "uncertainty",
    "idempotency_key"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "request_id": {"type": "string", "pattern": "^aar-[a-z0-9-]{8,64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "requested_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "team_id"],
      "properties": {
        "agent_id": {"type": "string", "minLength": 1},
        "team_id": {"type": "string", "minLength": 1}
      }
    },
    "action": {
      "type": "string",
      "enum": [
        "github.branch.push",
        "github.pull_request.create",
        "github.pull_request.merge",
        "github.tag.create",
        "github.release.create"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "repository", "resource_ref"],
      "properties": {
        "provider": {"const": "github"},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "resource_ref": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "parameters": {"type": "object"},
    "parameters_sha256": {"$ref": "#/$defs/sha256"},
    "evidence_requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}
    },
    "uncertainty": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "idempotency_key": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{16,128}$"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
